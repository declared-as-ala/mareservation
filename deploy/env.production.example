# Production environment for Exploria360.
# Copy to  <app dir>/backend/.env  ON THE SERVER (never commit the real file) and fill in.
# chmod 600 backend/.env

NODE_ENV=production
PORT=3001

# External MongoDB (Atlas). Use a dedicated least-privilege DB user for this app.
MONGODB_URI=mongodb+srv://<APP_USER>:<APP_PASSWORD>@<CLUSTER_HOST>/<DB_NAME>?retryWrites=true&w=majority

# >= 32 random chars:  openssl rand -base64 64
JWT_SECRET=

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

CORS_ORIGIN=https://www.exploria360.com
FRONTEND_URL=https://www.exploria360.com

# Public catalogue: ONLY the demo is public.
PUBLIC_VENUE_SLUGS=maison-hotes-demo-exploria360

# Where new owner-enquiry notifications go (comma separated). Empty = stored in DB only.
PARTNER_NOTIFICATION_EMAILS=

# Optional integrations (leave empty to disable)
EMAIL_FROM=
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_FILE_SIZE_MB=50
